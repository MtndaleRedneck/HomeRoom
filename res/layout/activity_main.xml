<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_hint"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/setup_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setup_field_hint"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:backgroundTint="@color/accent"
            android:inputType="textUri"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/setup_go"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_connect" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_title"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/error_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_retry" />

        <Button
            android:id="@+id/error_change"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/error_change" />
    </LinearLayout>
</FrameLayout>
