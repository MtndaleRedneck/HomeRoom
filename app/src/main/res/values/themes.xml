<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HomeRoom" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#fc8613</item>
        <item name="colorOnPrimary">#1a1206</item>
        <item name="android:statusBarColor">#1e1d20</item>
        <item name="android:navigationBarColor">#1e1d20</item>
        <item name="android:windowBackground">#1e1d20</item>
        <item name="android:alertDialogTheme">@style/Theme.HomeRoom.Dialog</item>
    </style>
    <!-- Stock dialogs on the app surface: dark card, rounded corners, accent buttons. -->
    <style name="Theme.HomeRoom.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:colorBackground">#18212b</item>
        <item name="android:colorBackgroundFloating">#18212b</item>
        <item name="android:textColorPrimary">#e9eef3</item>
        <item name="android:textColorSecondary">#8e9dac</item>
        <item name="android:textColorHint">#8e9dac</item>
        <item name="android:colorAccent">#fc8613</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.HomeRoom.DialogButton</item>
    </style>
    <style name="Widget.HomeRoom.DialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">#fc8613</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>